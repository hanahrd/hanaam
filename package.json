{
  "name": "hana-ai-market",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "dev:local": "tsx --env-file=.env scripts/dev-server.ts",
    "build": "node scripts/build-api.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "test": "vitest run",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:push": "supabase db push"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "hono": "^4.6.3",
    "postgres": "^3.4.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vercel": "^37.6.2",
    "vitest": "^2.1.1"
  }
}
