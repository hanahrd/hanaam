# 하나증권 AI 마켓 v1.3 — 서버 전용 환경변수
# NEXT_PUBLIC_ 등 브라우저 노출 접두사를 쓰지 않는다. 브라우저에는 어떤 값도 내려주지 않는다.

# Supabase 트랜잭션 풀러(6543) 연결 문자열. prepare:false, max:1로 사용한다.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Storage API 호출용 (서버 전용)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-here

# 시드 스크립트 전용(관리자 비밀번호만). 런타임 함수에는 불필요.
# 제작자(업로더) 계정은 시드하지 않는다. 관리자가 운영 화면("계정 추가")에서 닉네임+비밀번호를 생성한다.
ADMIN_PASSWORD=change-me-admin

# 크론 엔드포인트 보호
CRON_SECRET=generate-a-random-string

# Origin 검사 (쉼표로 구분, 운영 도메인만)
ALLOWED_ORIGINS=https://your-domain.vercel.app
